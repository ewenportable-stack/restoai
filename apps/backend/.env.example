NODE_ENV=development
PORT=3001

# Database (dev: Docker local | prod: Supabase)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chefai
DB_USER=chefai
DB_PASSWORD=chefai_dev

# Production Supabase (set these in Vercel env vars)
# DATABASE_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_ANON_KEY=<anon_key>
# SUPABASE_SERVICE_ROLE_KEY=<service_role_key>

# JWT
JWT_SECRET=change_me_in_production_use_long_random_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Mail (MailHog for dev)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=noreply@chefai.fr

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
